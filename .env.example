APP_ENV=local
APP_NAME=feishu-sample-reminder
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_ENABLED=true
CSRF_COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_HOSTS=ccn9vqxcon1p.feishu.cn,transsioner.feishu.cn
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

REDIS_URL=redis://localhost:6379/0
PREVIEW_TTL_SECONDS=86400
RESULT_TTL_SECONDS=604800
MAX_DATA_ROWS=300
MAX_RECIPIENTS=300
SEND_CONCURRENCY=5
SEND_AUTO_RETRIES=2
SEND_LOCK_TTL_SECONDS=600
RECOVERY_SCAN_SECONDS=30
SEND_TASK_TIMEOUT_SECONDS=600
MESSAGE_MAX_BYTES=30000
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_READ_TIMEOUT_SECONDS=10
TEMPLATE_VERSION=1
